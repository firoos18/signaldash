// signaldash-deploy-check — verifies ArgoCD deployed the merged image tags.
// Polls gitops repo for current desired tags, compares against running pods.
// Reports to console; fails if running != desired for >10min (stuck rollout).
// ponytail: reads desired tags from gitops main (source of truth), running from
//           pods. No ArgoCD API needed — pod tags are the ground truth.
pipeline {
    agent { label 'docker-builder' }

    environment {
        GITOPS_REPO = "https://github.com/firoos18/homelab-gitops.git"
    }

    stages {
        stage('Check deployment') {
            steps {
                container('git') {
                    withCredentials([string(credentialsId: 'github-pat', variable: 'GH_TOKEN')]) {
                        sh '''
                            set -e
                            rm -rf gitops && git clone --depth 1 "https://x-access-token:${GH_TOKEN}@${GITOPS_REPO#https://}" gitops
                            cd gitops
                            DESIRED_API=$(grep -oE "image: signaldash-api:[0-9]+" apps/signaldash/api.yaml | head -1 | grep -oE "[0-9]+$")
                            DESIRED_WEB=$(grep -oE "image: signaldash-web:[0-9]+" apps/signaldash/web.yaml | head -1 | grep -oE "[0-9]+$")
                            echo "Desired from gitops: api=${DESIRED_API} web=${DESIRED_WEB}"
                        '''
                    }
                }
                container('kubectl') {
                    sh '''
                        RUNNING_API=$(kubectl get pods -n signaldash -l app=signaldash-api -o jsonpath='{.items[0].spec.containers[0].image}' 2>/dev/null | sed 's/.*://')
                        RUNNING_WEB=$(kubectl get pods -n signaldash -l app=signaldash-web -o jsonpath='{.items[0].spec.containers[0].image}' 2>/dev/null | sed 's/.*://')
                        echo "Running: api=${RUNNING_API} web=${RUNNING_WEB}"
                        echo "DESIRED_API=$DESIRED_API DESIRED_WEB=$DESIRED_WEB" > /tmp/desired.env
                        echo "RUNNING_API=$RUNNING_API RUNNING_WEB=$RUNNING_WEB" > /tmp/running.env
                    '''
                }
                container('git') {
                    sh '''
                        . /tmp/desired.env 2>/dev/null || true
                        . /tmp/running.env 2>/dev/null || true
                        if [ "$RUNNING_API" = "$DESIRED_API" ] && [ "$RUNNING_WEB" = "$DESIRED_WEB" ]; then
                            echo "DEPLOYED: api:${DESIRED_API} web:${DESIRED_WEB} — ArgoCD synced, pods running desired tags"
                        else
                            echo "PENDING: desired api:${DESIRED_API} web:${DESIRED_WEB}, running api:${RUNNING_API} web:${RUNNING_WEB}"
                            echo "ArgoCD may still be rolling, or PR not merged yet."
                            exit 1
                        fi
                    '''
                }
            }
        }
    }
}
